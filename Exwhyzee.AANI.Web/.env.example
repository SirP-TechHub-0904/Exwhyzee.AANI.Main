# ==============================================================================
# Exwhyzee AANI Web Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5070

# Database Connection String
ConnectionStrings__DefaultConnection="Server=YOUR_DB_HOST,1433;Initial Catalog=YOUR_DB_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;"

# Token Secret & Voting
TokenSecret="YOUR_TOKEN_SECRET_HMAC_KEY"
VotingBaseUrl="https://aani.ng/"

# AWS S3 Storage Configuration
AwsConfiguration__AWSAccessKey="YOUR_AWS_ACCESS_KEY"
AwsConfiguration__AWSSecretKey="YOUR_AWS_SECRET_KEY"
AWS__Profile="local-test-profile"
AWS__Region="us-west-3"

# Kudi SMS Gateway
KudiSms__Token="YOUR_KUDI_SMS_TOKEN"
KudiSms__SenderId="AANI"
KudiSms__Gateway="2"
KudiSms__TemplateCode="YOUR_TEMPLATE_CODE"
KudiSms__PhoneId="YOUR_PHONE_ID"

# Postmark Transactional Email
PostmarkSettings__ServerToken="YOUR_POSTMARK_SERVER_TOKEN"

# Monnify Payment Gateway
Monnify__ApiKey="MK_TEST_XXXXXXXXXX"
Monnify__SecretKey="YOUR_MONNIFY_SECRET_KEY"
Monnify__ContractCode="YOUR_MONNIFY_CONTRACT_CODE"
Monnify__BaseUrl="https://sandbox.monnify.com"
Monnify__NationalSubAccountCode="MFY_SUB_NATIONAL_XXX"
Monnify__NationalSplitPercentage=30
Monnify__ChapterSplitPercentage=70
