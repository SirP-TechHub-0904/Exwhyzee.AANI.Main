@page
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Committee.IndexModel
@{
    ViewData["Title"] = "Committees";
}
<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">Committees</h3>
        <div class="card-tools">
            <a asp-page="./Create" class="btn btn-primary btn-sm">Create Committee</a>
        </div>
    </div>

    @await Html.PartialAsync("_MessageNotice")

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Name</th>
                        <th>Members</th>
                        <th>Active</th>
                        <th>Period</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Committees.Select((value, index) => (value, index)))
                    {
                        <tr>
                            <td>@(c.index + 1)</td>
                            <td>@c.value.Name</td>
                            <td>@c.value.Members.Count()</td>
                            <td>@(c.value.IsActive ? "Yes" : "No")</td>
                            <td>@(c.value.StartAt?.ToString("yyyy-MM-dd") ?? "—") - @(c.value.EndAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>
                                <a asp-page="./Details" asp-route-id="@c.value.Id" class="btn btn-sm btn-info">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>