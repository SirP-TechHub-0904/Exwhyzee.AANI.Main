@page "{id:long}"
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Committee.EditModel
@{
    ViewData["Title"] = "Edit Committee";
}
<div class="row">
    <div class="col-md-8">
        <!-- Card 1: Committee edit + Members list -->
        <div class="card card-default mb-3">
            <div class="card-header justify-content-between align-items-center">
                <h3 class="card-title mb-0">Edit Committee</h3>
                <a asp-page="./Details" asp-route-id="@Model.Committee.Id" class="btn btn-xs btn-secondary" style="float:right;">Back</a>
            </div>

            @await Html.PartialAsync("_MessageNotice")

            <div class="card-body">
                <form method="post" id="editCommitteeForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Committee.Id" />

                    <div class="form-group">
                        <label asp-for="Committee.Name"></label>
                        <input asp-for="Committee.Name" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Committee.Description"></label>
                        <textarea asp-for="Committee.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="col-md-4">
                            <label asp-for="Committee.StartAt"></label>
                            <input asp-for="Committee.StartAt" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Committee.EndAt"></label>
                            <input asp-for="Committee.EndAt" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check mt-2">
                                <input asp-for="Committee.IsActive" class="form-check-input" />
                                <label asp-for="Committee.IsActive" class="form-check-label">Is Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Committee</button>
                        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>

                <hr />

                <h5 class="mt-3">Members in Committee</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>S/N</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Position</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Committee.Members != null && Model.Committee.Members.Any())
                            {
                                var idx = 1;
                                foreach (var m in Model.Committee.Members.OrderBy(x => x.Order))
                                {
                                    <tr>
                                        <td>@(idx++)</td>
                                        <td>@(m.Participant?.Fullname ?? m.ParticipantId)</td>
                                        <td>@m.Participant?.Email</td>
                                        <td>@m.Participant?.PhoneNumber</td>
                                        <td class="member-position">@(!string.IsNullOrWhiteSpace(m.Role) ? m.Role : "Member")</td>
                                        <td class="text-right">
                                            <!-- Edit position: opens modal (submits to EditMember) -->
                                            <button type="button"
                                                    class="btn btn-xs btn-outline-primary editMemberBtn"
                                                    data-participant-id="@m.ParticipantId"
                                                    data-participant-name="@(m.Participant?.Fullname ?? "")"
                                                    data-position="@(m.Role ?? "")"
                                                    data-toggle="modal"
                                                    data-target="#editMemberModal">
                                                Edit
                                            </button>

                                            <!-- Remove button: posts to handler RemoveMember -->
                                            <form method="post" class="d-inline" asp-page-handler="RemoveMember">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="committeeId" value="@Model.Committee.Id" />
                                                <input type="hidden" name="participantId" value="@m.ParticipantId" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger" onclick="return confirm('Remove member?');">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6">No members yet</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Card 2: Dropdown of participants and Add to member -->
        <div class="card card-default mb-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Add Participant to Committee</h5>
            </div>

            <div class="card-body">
                <form method="post" asp-page-handler="AddMember" id="addMemberForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="committeeId" value="@Model.Committee.Id" />
                    <div class="form-group">
                        <label for="participantSelect">Select participant</label>
                        <select id="participantSelect" name="participantId" class="form-control select2 select2-primary js-example-basic-single">
                            <option value="">-- choose participant --</option>
                            @* Render preview participants excluding ones already in committee *@
                            @{
                                var memberIds = Model.Committee.Members?.Select(m => m.ParticipantId).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>();
                            }
                            @foreach (var p in Model.ParticipantsPreview)
                            {
                                if (memberIds.Contains(p.Id)) { continue; }
                                <option value="@p.Id">@p.Fullname @(!string.IsNullOrWhiteSpace(p.Email) ? " — " + p.Email : "")</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Add to members</button>
                    </div>
                </form>

                @*<hr />

                <div>
                    <small class="text-muted">If the person you want is not in the dropdown, use the search box above to find them (server search) or increase preview size on server.</small>
                </div>*@
            </div>
        </div>
    </div>
</div>

<!-- Edit Member Position Modal (submits to EditMember handler) -->
<div class="modal fade" id="editMemberModal" tabindex="-1" role="dialog" aria-labelledby="editMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditMember">
                @Html.AntiForgeryToken()
                <input type="hidden" name="committeeId" value="@Model.Committee.Id" />
                <input type="hidden" id="modalParticipantId" name="participantId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editMemberModalLabel">Edit Member Position</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label id="modalParticipantNameLabel"></label>
                    </div>
                    <div class="form-group">
                        <label>Position / Role</label>
                        <input type="text" id="modalPositionInput" name="position" class="form-control" placeholder="e.g. Chair, Secretary, Member" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Position</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // wire modal open button to fill fields
            $(document).on('click', '.editMemberBtn', function () {
                var pid = $(this).data('participant-id');
                var pname = $(this).data('participant-name') || '';
                var pos = $(this).data('position') || '';
                $('#modalParticipantId').val(pid);
                $('#modalParticipantNameLabel').text(pname);
                $('#modalPositionInput').val(pos);
            });
        });
    </script>
}