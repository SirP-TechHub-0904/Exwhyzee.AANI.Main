@page "{id:long}"
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Committee.DetailsModel
@{
    ViewData["Title"] = "Committee Details";
}
<div class="card card-default">
    <div class="card-header justify-content-between align-items-center">
        <h3 class="card-title mb-0">Committee: @Model.Committee.Name</h3>
        
            <a class="btn btn-xs btn-primary" asp-page="./Edit" asp-route-id="@Model.Committee.Id" style="float:right;">Edit</a>
            <button class="btn btn-xs btn-danger" data-toggle="modal" data-target="#deleteCommitteeModal" style="float:right;">Delete</button>
            <a asp-page="./Index" class="btn btn-xs btn-secondary" style="float:right;">Back</a>
         
    </div>

    @await Html.PartialAsync("_MessageNotice")

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Committee.Description</dd>

            <dt class="col-sm-2">Period</dt>
            <dd class="col-sm-10">
                @(Model.Committee.StartAt?.ToString("yyyy-MM-dd") ?? "—")
                -
                @(Model.Committee.EndAt?.ToString("yyyy-MM-dd") ?? "—")
            </dd>

            <dt class="col-sm-2">Active</dt>
            <dd class="col-sm-10">@((Model.Committee.IsActive) ? "Yes" : "No")</dd>

            <dt class="col-sm-2">Members</dt>
            <dd class="col-sm-10">@Model.Committee.Members.Count()</dd>
        </dl>

        <hr />

        <h5>Members</h5>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Committee.Members.OrderBy(x => x.Order).Select((value, index) => (value, index)))
                    {
                        <tr>
                            <td>@(m.index + 1)</td>
                            <td>@m.value.Participant?.Fullname</td>
                            <td>@m.value.Participant?.Email</td>
                            <td>@m.value.Participant?.PhoneNumber</td>
                            <td>@(m.value.Role ?? "Member")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <hr />

        <!-- Send to Committee Members -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Send Email to Committee Members</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Notify" id="notifyCommitteeForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Committee.Id" />

                    <div class="form-row">
                       
                            <label>Members to send</label>
                            <div class="form-control-plaintext">
                                <strong>@Model.Committee.Members.Count()</strong> members
                            </div> 
                    </div>

                    <div class="form-group mt-3" id="notifySubjectRow">
                        <label>Subject</label>
                        <input asp-for="NotifySubject" class="form-control" id="notifySubject" />
                    </div>

                    <div class="form-group" id="notifyBodyRow">
                        <label>Message Body</label>
                        <textarea asp-for="NotifyBody" class="form-control" id="notifyBodyEditor" rows="6"></textarea>
                        <small class="form-text text-muted">You may use tokens like <code>{{fullname}}</code> and <code>{{committeeName}}</code>.</small>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success">Send to Members</button> 
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
 
<!-- Delete Committee Modal -->
<div class="modal fade" id="deleteCommitteeModal" tabindex="-1" role="dialog" aria-labelledby="deleteCommitteeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Committee.Id" value="@Model.Committee.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCommitteeModalLabel">Delete Committee</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete the committee "<strong>@Model.Committee.Name</strong>"? This will remove all committee members.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Template preview modal (reuse existing style) *@
@await Html.PartialAsync("/Areas/Datapage/Pages/NewsletterPage/Templates/_TemplatePreviewModal.cshtml")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" />

    <script>
        $(function () {
            // initialize editor
            $('#notifyBodyEditor').summernote({ height: 200 });

            // when template changes, load template content via handler
            $('#notifyTemplateSelect').change(function () {
                var id = $(this).val();
                if (!id) {
                    // show defaults
                    $('#notifySubject').val('@Model.DefaultNotifySubject.Replace("'", "\\'")');
                    if ($('#notifyBodyEditor').data('summernote')) {
                        $('#notifyBodyEditor').summernote('code', '@Model.DefaultNotifyBody.Replace("'", "\\'").Replace("\r\n","\\n")');
                    } else {
                        $('#notifyBodyEditor').val('@Model.DefaultNotifyBody.Replace("'", "\\'")');
                    }
                    return;
                }

                $.get('@Url.Page("./Details", "LoadTemplate")', { id: id, committeeId: @Model.Committee.Id })
                    .done(function (data) {
                        $('#notifySubject').val(data.subject || '');
                        if ($('#notifyBodyEditor').data('summernote')) {
                            $('#notifyBodyEditor').summernote('code', data.body || '');
                        } else {
                            $('#notifyBodyEditor').val(data.body || '');
                        }
                    })
                    .fail(function () {
                        alert('Failed to load template');
                    });
            });

            // Preview: post current subject/body to preview endpoint in Templates area
            $('#previewNotifyBtn').click(function (e) {
                e.preventDefault();
                var subj = $('#notifySubject').val() || '';
                var body = $('#notifyBodyEditor').data('summernote') ? $('#notifyBodyEditor').summernote('code') : $('#notifyBodyEditor').val();

                $.post('@Url.Page("/Datapage/NewsletterPage/Templates/Preview", "Render")', { subject: subj, body: body, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function (data) {
                        $('#templatePreviewModal #previewSubject').text(data.subject || '');
                        $('#templatePreviewModal #previewBody').html(data.body || '');
                        $('#templatePreviewModal').modal('show');
                    })
                    .fail(function () {
                        alert('Preview failed');
                    });
            });

            // set defaults initially
            if (!$('#notifyTemplateSelect').val()) {
                $('#notifySubject').val('@Model.DefaultNotifySubject.Replace("'", "\\'")');
                if ($('#notifyBodyEditor').data('summernote')) {
                    $('#notifyBodyEditor').summernote('code', '@Model.DefaultNotifyBody.Replace("'", "\\'").Replace("\r\n","\\n")');
                }
            }
        });
    </script>
}