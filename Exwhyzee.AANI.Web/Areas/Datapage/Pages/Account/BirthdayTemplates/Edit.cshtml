@page "{id:long}"
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Account.BirthdayTemplates.EditModel
@{
    ViewData["Title"] = "Edit Birthday Template";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Birthday Template</h3>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group">
                <label asp-for="Input.Name">Name</label>
                <input asp-for="Input.Name" class="form-control" required />
            </div>

            <div class="form-group">
                <label asp-for="Input.SendTime">Send Time</label>
                <input asp-for="Input.SendTime" type="time" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Input.EmailSubject">Email Subject</label>
                <input asp-for="Input.EmailSubject" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Input.EmailBody">Email Body</label>
                <textarea asp-for="Input.EmailBody" class="form-control" rows="10"></textarea>
            </div>

            <div class="form-group form-check">
                <input asp-for="Input.IsEnabled" class="form-check-input" />
                <label asp-for="Input.IsEnabled" class="form-check-label">Enabled</label>
            </div>

            <div class="form-group">
                <button class="btn btn-primary" type="submit">Save</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>