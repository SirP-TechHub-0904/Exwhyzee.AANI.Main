@page "{id:long}"
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Account.BirthdayTemplates.DetailsModel
@{
    ViewData["Title"] = "Template Details";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Template Details</h3>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.Template.Id" class="btn btn-sm btn-secondary">Edit</a>
            <a asp-page="./Index" class="btn btn-sm btn-light">Back</a>
        </div>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Template.Name</dd>

            <dt class="col-sm-3">Send Time</dt>
            <dd class="col-sm-9">@Model.Template.SendTime.ToString()</dd>

            <dt class="col-sm-3">Enabled</dt>
            <dd class="col-sm-9">@Model.Template.IsEnabled</dd>

            <dt class="col-sm-3">Email Subject</dt>
            <dd class="col-sm-9">@Model.Template.EmailSubject</dd>

            <dt class="col-sm-3">Email Body</dt>
            <dd class="col-sm-9"><div class="border p-2">@Html.Raw(Model.Template.EmailBody)</div></dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.Template.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Updated</dt>
            <dd class="col-sm-9">@Model.Template.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>