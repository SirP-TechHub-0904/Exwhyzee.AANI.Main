@page
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Account.PaperListModel
@{
}

<div class="library-search-container">
    <form method="get" asp-page="./PaperList" class="modern-search-form">
        <input type="hidden" name="id" value="@Model.PaperCategory.Id" />
        <div class="search-wrapper">
            <i class="fa fa-search search-icon"></i>
            <input type="text" name="searchString" class="search-input"
                   placeholder="Search academic papers..." value="@Model.CurrentFilter" />
            <button class="search-btn" type="submit">Search</button>
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.CurrentFilter))
    {
        <div class="results-badge">
            Showing @Model.Papers.Count() results for "@Model.CurrentFilter"
        </div>
    }
</div>

<div class="library-grid-container">
    <div class="grid-header">
        <h2>@Model.PaperCategory.Title</h2>
        <div class="header-line"></div>
    </div>

    <div class="paper-grid">
        @foreach (var paper in Model.Papers)
        {
            <div class="paper-card view-details"
                 data-id="@paper.Id"
                 data-title="@paper.Title"
                 data-fileurl="@(paper.AdminApproved ? paper.FileUrl : "")">

                <div class="paper-image-wrapper">
                    <img src="@(string.IsNullOrWhiteSpace(paper.CoverUrl) ? "/Book-cover-AANI.jpg" : paper.CoverUrl)" alt="Cover" />
                    @if (string.IsNullOrWhiteSpace(paper.FileUrl))
                    {
                        <div class="status-badge">Not Uploaded</div>
                    }
                    else if (!paper.AdminApproved)
                    {
                        <div class="status-badge pending">
                            <i class="fa fa-clock"></i> Pending Approval
                        </div>
                        <div class="card-overlay info">
                            <span>Uploaded. Awaiting Admin Review</span>
                        </div>
                    }
                    else
                    {
                        <div class="card-overlay"><i class="fa fa-eye"></i> Read Paper</div>
                    }
                </div>

                <div class="paper-content">
                    <h3 class="paper-title">@paper.Title</h3>
                    <div class="paper-meta">
                        <span class="meta-label">Author</span>
                        <span class="meta-value">@(paper.Participant?.Fullname ?? "N/A") (@paper.Year)</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- Bookshelf Bottom -->
<div class="bookshelf-3d-bottom">
    @if (Model.Papers.TotalPages > 1)
    {
        <nav class="bookshelf-pagination mt-4">
            <ul class="pagination pagination-controls justify-content-center" style="padding-top:1px;">
                <!-- First page «« -->
                <li class="page-item @(Model.Papers.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./PaperList"
                       asp-route-pageIndex="1"
                       asp-route-currentFilter="@Model.CurrentFilter"
                       asp-route-id="@Model.PaperCategory.Id">&laquo;&laquo;</a>
                </li>
                <!-- Previous page « -->
                <li class="page-item @(Model.Papers.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./PaperList"
                       asp-route-pageIndex="@(Model.Papers.PageIndex - 1)"
                       asp-route-currentFilter="@Model.CurrentFilter"
                       asp-route-id="@Model.PaperCategory.Id">&laquo;</a>
                </li>
                <!-- First 3 pages -->
                @for (int i = 1; i <= Math.Min(3, Model.Papers.TotalPages); i++)
                {
                    <li class="page-item @(i == Model.Papers.PageIndex ? "active" : "")">
                        <a class="page-link" asp-page="./PaperList"
                           asp-route-pageIndex="@i"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-id="@Model.PaperCategory.Id">@i</a>
                    </li>
                }
                <!-- Ellipsis if more than 6 pages -->
                @if (Model.Papers.TotalPages > 6)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <!-- Last 3 pages -->
                @for (int i = Model.Papers.TotalPages - 2; i <= Model.Papers.TotalPages; i++)
                {
                    if (i > 3)
                    {
                        <li class="page-item @(i == Model.Papers.PageIndex ? "active" : "")">
                            <a class="page-link" asp-page="./PaperList"
                               asp-route-pageIndex="@i"
                               asp-route-currentFilter="@Model.CurrentFilter"
                               asp-route-id="@Model.PaperCategory.Id">@i</a>
                        </li>
                    }
                }
                <!-- Next page » -->
                <li class="page-item @(Model.Papers.PageIndex == Model.Papers.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="./PaperList"
                       asp-route-pageIndex="@(Model.Papers.PageIndex + 1)"
                       asp-route-currentFilter="@Model.CurrentFilter"
                       asp-route-id="@Model.PaperCategory.Id">&raquo;</a>
                </li>
                <!-- Last page »» -->
                <li class="page-item @(Model.Papers.PageIndex == Model.Papers.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="./PaperList"
                       asp-route-pageIndex="@(Model.Papers.TotalPages)"
                       asp-route-currentFilter="@Model.CurrentFilter"
                       asp-route-id="@Model.PaperCategory.Id">&raquo;&raquo;</a>
                </li>
            </ul>
            @*<span style="margin-left:10px;">
                    <i>Page Number (@Model.Papers.PageIndex of @Model.Papers.TotalPages)</i>
                </span>*@
        </nav>
    }
</div>
<div class="modal fade" id="readerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header" style="background: #30614b; color: white;">
                <h5 class="modal-title" id="readerTitle">Reading Paper</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfFrame" src="" width="100%" height="100%" frameborder="0"></iframe>
            </div>
        </div>
    </div>
</div>
<style>
    /* Container & Spacing */
    .library-grid-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    /* Modern Search Bar */
    .library-search-container {
        padding: 40px 0;
        text-align: center;
    }

    .search-wrapper {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        background: #fff;
        padding: 8px;
        border-radius: 50px;
        box-shadow: 0 10px 30px rgba(48, 97, 75, 0.1);
        border: 1px solid #e0e0e0;
    }

    .search-icon {
        margin-left: 20px;
        color: #30614b;
    }

    .search-input {
        border: none;
        flex: 1;
        padding: 10px 15px;
        font-size: 1rem;
        outline: none;
    }

    .search-btn {
        background: #30614b;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .search-btn:hover {
            background: #1b3d2f;
            transform: scale(1.05);
        }

    /* Section Header */
    .grid-header h2 {
        color: #1b3d2f;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .header-line {
        width: 60px;
        height: 4px;
        background: #30614b;
        margin-bottom: 30px;
    }

    /* The Paper Grid */
    .paper-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    /* Elegant Paper Card */
    .paper-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
        border: 1px solid #f0f0f0;
    }

        .paper-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }

    /* Image 40% height */
    .paper-image-wrapper {
        position: relative;
        height: 180px;
        overflow: hidden;
    }

        .paper-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(48, 97, 75, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .paper-card:hover .card-overlay {
        opacity: 1;
    }

    /* Content 60% height */
    .paper-content {
        padding: 20px;
        display: flex;
        flex-direction: column;
        height: 220px;
    }

    .paper-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: auto;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .paper-meta {
        border-top: 1px solid #eee;
        padding-top: 15px;
        margin-top: 15px;
    }

    .meta-label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #30614b;
        font-weight: 800;
    }

    .meta-value {
        font-size: 0.9rem;
        color: #666;
        font-style: italic;
    }

    /* Tablet/Mobile fixes */
    @@media (max-width: 600px) {
        .paper-grid {
            grid-template-columns: 1fr;
        }
    }

    .paper-card.no-document {
        opacity: 0.8;
        filter: grayscale(0.5); /* Subtle hint that it's inactive */
    }

    .status-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #e74c3c;
        color: white;
        font-size: 0.7rem;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: bold;
        z-index: 5;
    }

    /* Styling for cards without a document */
    .paper-card.is-empty {
        cursor: default;
        border: 1px dashed #ccc; /* Dashed border looks "unfinished" */
    }

        .paper-card.is-empty .paper-image-wrapper img {
            opacity: 0.5;
            filter: grayscale(1); /* Makes the cover look inactive */
        }

    /* The red badge for missing files */
    .status-badge-missing {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #dc3545; /* Academic red */
        color: white;
        font-size: 0.7rem;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: bold;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    /* Ensure the overlay only shows on cards that actually have a file */
    .paper-card.has-file:hover .card-overlay {
        opacity: 1;
    }
    /* Status Badges */
    .status-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.7rem;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: bold;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .status-badge.missing {
            background: #6c757d;
            color: white;
        }
        /* Gray for empty */
        .status-badge.pending {
            background: #f39c12;
            color: white;
        }
    /* Orange for waiting */

    /* Overlays */
    .card-overlay.info {
        background: rgba(44, 62, 80, 0.85); /* Dark blue/gray */
        opacity: 0;
        font-size: 0.9rem;
        text-align: center;
        padding: 10px;
    }

    .paper-card.is-pending:hover .card-overlay.info {
        opacity: 1;
    }

    .card-overlay.success {
        background: rgba(48, 97, 75, 0.9); /* Your Brand Green */
    }
</style>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.querySelectorAll('.view-details').forEach(card => {
            card.addEventListener('click', function () {
                const fileUrl = this.getAttribute('data-fileurl');
                const title = this.getAttribute('data-title');

                if (!fileUrl || fileUrl === "" || fileUrl === "null") {
                    alert("This paper has been uploaded but is currently awaiting Admin Approval. Please check back later!");
                    return;
                }

                document.getElementById('readerTitle').innerText = title;

                // CHECK: Is it a Word Doc?
                if (fileUrl.toLowerCase().endsWith('.docx') || fileUrl.toLowerCase().endsWith('.doc')) {
                    // We wrap the URL in Microsoft's viewer
                    const encodedUrl = encodeURIComponent(fileUrl);
                    document.getElementById('pdfFrame').src = `https://view.officeapps.live.com/op/view.aspx?src=${encodedUrl}`;
                } else {
                    // If it's a PDF, we show it directly
                    document.getElementById('pdfFrame').src = fileUrl;
                }

                var myModal = new bootstrap.Modal(document.getElementById('readerModal'));
                myModal.show();
            });
        });
    </script>
}

