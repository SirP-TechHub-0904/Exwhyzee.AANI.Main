@page
@model Exwhyzee.AANI.Web.Areas.Datapage.Pages.Account.NewsletterModel
@{
    ViewData["Title"] = "My Newsletters & Notifications";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Newsletters</h3>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmailHistory.Any())
                    {
                        foreach (var item in Model.EmailHistory)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td><strong>@item.Subject</strong></td>
                                <td>
                                    <span class="badge @(item.Sent ? "badge-success" : "badge-warning")">
                                        @(item.Sent ? "Received" : "Pending")
                                    </span>
                                </td>
                                <td class="text-right">
                                    <button class="btn btn-sm btn-info view-email" data-id="@item.Id">
                                        <i class="fas fa-eye"></i> View Content
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">You have no notification history.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="emailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mSubject"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted small" id="mDate"></p>
                <hr />
                <div id="mContent" style="min-height: 200px; overflow-y: auto;">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.view-email').click(function () {
                var id = $(this).data('id');
                $('#mContent').html('<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');
                $('#emailModal').modal('show');

                $.get('?handler=Details&id=' + id, function (data) {
                    $('#mSubject').text(data.subject);
                    $('#mDate').text("Received on: " + data.date);
                    // Using .html() because content likely contains HTML tags from the newsletter
                    $('#mContent').html(data.content);
                });
            });
        });
    </script>
}