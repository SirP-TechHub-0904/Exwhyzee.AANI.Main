@page
@model Exwhyzee.AANI.Web.Areas.Main.Pages.ParticipantPage.UpdateIDCardModel
@{
}
<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">UPDATE ID CARD INFORMATION</h3>
         
    </div>
    <div class="card-header">
        <h3 class="card-title"> @Model.Participant.Title @Model.Participant.Surname @Model.Participant.FirstName @Model.Participant.OtherName </h3>


    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Participant.Id" />
                    <div class="form-group">
                        <div class="row">
                            <div class="col-lg-6">
                                <label asp-for="Participant.Title" class="control-label"></label>
                                <select asp-for="Participant.Title"
                                        asp-items="Model.TitleList"
                                        class="form-control uppercase-text"
                                        required>
                                </select>                        <span asp-validation-for="Participant.Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Participant.Surname" class="control-label"></label>
                                <input asp-for="Participant.Surname" class="form-control" />
                                <span asp-validation-for="Participant.Surname" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="row">
                            <div class="col-lg-6">
                                <label asp-for="Participant.FirstName" class="control-label"></label>
                                <input asp-for="Participant.FirstName" class="form-control" />
                                <span asp-validation-for="Participant.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Participant.OtherName" class="control-label"></label>
                                <input asp-for="Participant.OtherName" class="form-control" />
                                <span asp-validation-for="Participant.OtherName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                        
                      
                    <div class="form-group">
                        <label asp-for="Participant.SECId" class="control-label">SEC YEAR</label>
                        <select asp-for="Participant.SECId" asp-items="ViewBag.SECId" required="required" class="form-control select2 select2-primary js-example-basic-single" data-dropdown-css-class="select2-primary">
                            <option>Select SEC</option>

                        </select>                        <span asp-validation-for="Participant.SECId" class="text-danger"></span>
                    </div>

                   
                    @if (!String.IsNullOrEmpty(Model.Participant.PictureUrl))
                    {
                        <div class="form-group">
                            <label class="control-label">Previous Passport Photograph</label><br />
                            <img src="@Model.Participant.PictureUrl" style="max-height:200px;" />
                        </div>
                    }
                    <div class="form-group">
                        <label class="control-label">Passport Photograph</label><br />
                        <input type="file" class="control-label" asp-for="imagefile" accept="image/*" />
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                        <a asp-page="./Index" class="btn bg-gradient-warning btn-sm" style="float:right;">Back</a>

                    </div>
                </form>
            </div>
        </div>


        <!-- /.row -->
    </div>
    <!-- /.card-body -->
    <div class="card-footer">
    </div>
</div>