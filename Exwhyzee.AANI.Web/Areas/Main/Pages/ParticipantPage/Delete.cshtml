@page "{id?}"
@model Exwhyzee.AANI.Web.Areas.Main.Pages.ParticipantPage.DeleteModel

@{
    ViewData["Title"] = "Delete Participant";
}

<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">Delete Participant</h3>
    </div>

    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="alert alert-danger">
            <strong>Warning:</strong> This action will delete the participant account and all configured dependent records found on this page.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.Participant.Fullname</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Participant.Email</dd>

            <dt class="col-sm-3">User Id</dt>
            <dd class="col-sm-9">@Model.Participant.Id</dd>

            <dt class="col-sm-3">Delete Confirmation Text</dt>
            <dd class="col-sm-9">
                <code>@Model.ExpectedConfirmationText</code>
            </dd>
        </dl>

        <hr />

        <h4>Where this user was found</h4>

        @if (Model.Usages.Any())
        {
            <p>
                <strong>Total references found:</strong> @Model.TotalReferences
            </p>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Meaning</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Usages)
                        {
                            <tr>
                                <td>@item.Location</td>
                                <td>@item.Meaning</td>
                                <td>@item.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-success">
                No dependent records were found for this participant.
            </div>
        }

        <hr />

        <form method="post">
            <input type="hidden" name="id" value="@Model.Participant.Id" />

            <div class="form-group">
                <label asp-for="ConfirmationText">
                    To confirm delete, type:
                    <strong style="background-color:yellow;color:black;"><i>@Model.ExpectedConfirmationText</i></strong>
                </label>
                <input asp-for="ConfirmationText" class="form-control" autocomplete="off" required="required" placeholder="type confirmation text above to delete" />
                <span asp-validation-for="ConfirmationText" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-danger">
                    Delete Completely
                </button>
                <a asp-page="./Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>