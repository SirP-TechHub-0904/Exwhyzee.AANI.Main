@page "{id}"
@model Exwhyzee.AANI.Web.Pages.ExecutiveDetailsModel
@{
    ViewData["Title"] = "Executive Profile";
}

<section class="content-header bg-light py-4 border-bottom mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="font-weight-bold">Executive Profile</h1>
            </div>
            <div class="col-md-4 text-md-right">
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.Participant.PictureUrl))
                            {
                                <img src="@Model.Participant.PictureUrl" class="img-fluid rounded shadow-sm" style="width: 100%; max-width: 250px; border: 4px solid #f8f9fa;" alt="@Model.Participant.Fullname">
                            }
                            else
                            {
                                <img src="~/img/upload.jpg" class="img-fluid rounded" style="width: 100%; max-width: 250px;" alt="Default">
                            }
                        </div>
                        <h4 class="font-weight-bold mb-1">@Model.Participant.Fullname</h4>
                        <p class="text-success font-weight-bold">@Model.Participant.CurrentPosition</p>
                        <div class="badge badge-dark p-2 w-100 mb-2">
                            SEC @(Model.Participant.SEC?.Number) (@(Model.Participant.SEC?.Year))
                        </div>
                        <div class="text-muted small">
                            <i class="fas fa-map-marker-alt"></i> @(Model.Participant.Chapter?.State ?? "National") Chapter
                        </div>
                    </div>
                </div>
 
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fas fa-user-tie text-success mr-2"></i>
                        <h5 class="mb-0 font-weight-bold">Biography</h5>
                    </div>
                    <div class="card-body" style="line-height: 1.8; color: #333;">
                        @if (!string.IsNullOrWhiteSpace(Model.Participant.Bio))
                        {
                            @Html.Raw(Model.Participant.Bio)
                        }
                        else
                        {
                            <p class="text-muted">No biography available for this executive.</p>
                        }
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fas fa-history text-success mr-2"></i>
                        <h5 class="mb-0 font-weight-bold">Executive History</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Position</th>
                                    <th>Service Period</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var history in Model.ExecutiveHistory)
                                {
                                    <tr>
                                        <td class="font-weight-bold">@history.ExecutivePosition?.Position</td>
                                        <td>@(history.OperationYear?.Name ?? $"{history.StartDate:yyyy} - {history.EndDate:yyyy}")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fas fa-book-open text-success mr-2"></i>
                        <h5 class="mb-0 font-weight-bold">Papers & Publications</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.PaperGroups.Any())
                        {
                            @foreach (var group in Model.PaperGroups)
                            {
                                <h6 class="text-success font-weight-bold border-bottom pb-1 mt-3">@group.CategoryName</h6>
                                <ul class="list-unstyled">
                                    @foreach (var paper in group.Papers)
                                    {
                                        <li class="mb-2 d-flex justify-content-between align-items-start">
                                            <span>
                                                <i class="far fa-file-alt text-muted mr-2"></i> @paper.Title
                                            </span>
                                            <span class="badge badge-light border ml-2">@paper.Year</span>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No published papers recorded.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-top-left-radius: 10px !important;
        border-top-right-radius: 10px !important;
    }

    .text-success {
        color: #28a745 !important;
    }
</style>